{
	"name": "obsidian-monolith",
	"version": "0.6.3",
	"description": "Monolith \u2014 FootPrintStudio Obsidian mega-plugin (single BRAT artifact, module enable flags).",
	"private": true,
	"type": "module",
	"main": "main.js",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"test": "npm run test --workspaces --if-present",
		"test:host": "vitest run"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"moment": "^2.30.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	}
}
